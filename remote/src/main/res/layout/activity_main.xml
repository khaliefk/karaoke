<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/scan_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/scan_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Buka aplikasi Karaoke for TV di TV, lalu scan QR-nya dari sini."
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <Button
            android:id="@+id/scan_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#16A34A"
            android:text="Scan QR TV"
            android:textColor="#FFFFFF" />

        <!-- v1.3.5: entri kode manual. Kalau kamera HP tidak bisa
             dipakai (FC / pratinjau hitam), user tetap bisa pairing
             dengan mengetik IP + kode 6 digit yang tampil di layar TV. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="atau masukkan kode manual"
            android:textColor="#AAAAAA"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/manual_ip"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="IP TV, contoh 192.168.1.5"
            android:inputType="textUri"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888" />

        <EditText
            android:id="@+id/manual_code"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Kode 6 digit di TV"
            android:inputType="number"
            android:maxLength="6"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888" />

        <Button
            android:id="@+id/manual_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#16A34A"
            android:text="Sambungkan"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</FrameLayout>
